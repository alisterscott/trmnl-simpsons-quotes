{% template simpsons_quote %}
{% comment %}
  Shared layout for every view. Each view file renders this template with:

    characters      the static_data characters (id, name, imageUrl, quotes)
    trmnl           the TRMNL context (for the selected character_ids setting)
    view_name       adds a `layout--<view_name>` class for per-view CSS
    lg_clamp, lg_portrait_clamp
                    max quote lines on large screens (landscape / portrait)
    sm_size, lg_size
                    quote text size classes (base/md and lg breakpoints)
    sm_long_size, lg_long_size
                    smaller size classes used for long quotes
{% endcomment %}

{% comment %} Quotes longer than this many characters use the "long" text sizes. {% endcomment %}
{% assign long_quote_length = 55 %}

{% comment %}
  character_ids can arrive as an array, a JSON-style string such as
  '["a", "b"]', or a plain comma list. Normalise all of them to "a,b".
  An empty result means no filter: every character is eligible.
{% endcomment %}
{% assign selected_ids_csv = trmnl.plugin_settings.custom_fields_values.character_ids
  | join: ','
  | remove: '['
  | remove: ']'
  | remove: '"'
  | remove: ' '
%}
{% assign selected_ids = selected_ids_csv | split: ',' %}
{% assign include_all = false %}
{% if selected_ids_csv == blank %}
  {% assign include_all = true %}
{% endif %}

{% comment %} Count the quotes that can be chosen. {% endcomment %}
{% assign eligible_quote_count = 0 %}
{% for character in characters %}
  {% if include_all or selected_ids contains character.id %}
    {% assign eligible_quote_count = eligible_quote_count | plus: character.quotes.size %}
  {% endif %}
{% endfor %}

{% if eligible_quote_count > 0 %}
  {% comment %}
    Pick the Nth eligible quote, where N changes every second. Walk the
    eligible characters, skipping each one's quotes until N lands inside one.
  {% endcomment %}
  {% assign quote_index = 'now' | date: '%s' | modulo: eligible_quote_count %}
  {% assign selected_quote = '' %}
  {% assign selected_character = '' %}
  {% for character in characters %}
    {% if include_all or selected_ids contains character.id %}
      {% if quote_index < character.quotes.size %}
        {% assign selected_quote = character.quotes[quote_index] %}
        {% assign selected_character = character %}
        {% break %}
      {% endif %}
      {% assign quote_index = quote_index | minus: character.quotes.size %}
    {% endif %}
  {% endfor %}

  {% if selected_quote.size > long_quote_length %}
    {% assign quote_size = sm_long_size %}
    {% assign quote_size_lg = lg_long_size %}
  {% else %}
    {% assign quote_size = sm_size %}
    {% assign quote_size_lg = lg_size %}
  {% endif %}

  <div class="layout h--full layout--{{ view_name }}">
    <div class="flex flex--row portrait:flex--col flex--stretch h--full">
      <section class="w--[80cqw] lg:w--[75cqw] portrait:w--full h--full portrait:h--[65cqh] flex flex--col flex--top portrait:flex--center gap--distribute">
        <div class="content h--max-[70cqh] portrait:h--max-[52cqh]" data-content-limiter="true">
          <blockquote
            class="{{ quote_size }} {{ quote_size_lg }} pl--1"
            data-clamp="3"
            data-clamp-sm="4"
            data-clamp-md="5"
            data-clamp-lg="{{ lg_clamp }}"
            data-clamp-portrait="4"
            data-clamp-sm-portrait="4"
            data-clamp-md-portrait="4"
            data-clamp-lg-portrait="{{ lg_portrait_clamp }}"
          >&ldquo;{{ selected_quote | escape }}&rdquo;</blockquote>
        </div>
        <p class="text--base md:text--large lg:text--xxlarge" data-testid="character-name">
          {{ selected_character.name | escape }}
        </p>
      </section>
      <div class="character-art w--[20cqw] lg:w--[25cqw] portrait:w--full h--full portrait:h--[35cqh] flex flex--center">
        <img class="image image--contain image-dither w--full h--full" src="{{ selected_character.imageUrl | escape }}" alt="{{ selected_character.name | escape }}">
      </div>
    </div>
  </div>
  <style>
    blockquote { overflow-wrap: anywhere; }
    .screen--lg:not(.screen--portrait) .layout--quadrant [data-content-limiter="true"] { max-height: 82cqh; }
    .screen--lg:not(.screen--portrait) .layout--quadrant [data-testid="character-name"] { margin-top: auto; }
    .screen--lg:not(.screen--portrait) .layout--quadrant .character-art img { object-position: center bottom; }
  </style>
{% else %}
  <div class="layout h--full">
    <div class="content">
      <p class="text--base">No quotes found for the selected characters.</p>
    </div>
  </div>
{% endif %}
{% endtemplate %}
