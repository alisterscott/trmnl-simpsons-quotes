{% template simpsons_quote %}
{% comment %}
  Shared layout for every view. Each view file renders this template with:

    characters      the static_data characters (id, name, imageUrl, quotes)
    trmnl           the TRMNL context (for the character_ids and
                    randomise_characters settings)
    view_name       adds a `layout--<view_name>` class for per-view CSS
    clamp_sm, clamp_md, clamp_lg
    clamp_sm_portrait, clamp_md_portrait, clamp_lg_portrait
                    max quote lines per screen size, landscape / portrait.
                    Sized to what fits above the character name, so a quote
                    is only cut off when it really would not fit.
    sm_size, lg_size
                    quote text size classes (base/md and lg breakpoints)
    sm_long_size, lg_long_size
                    smaller size classes used for long quotes
{% endcomment %}

{% comment %} Quotes longer than this many characters use the "long" text sizes. {% endcomment %}
{% assign long_quote_length = 55 %}

{% comment %}
  character_ids can arrive as an array, a JSON-style string such as
  '["a", "b"]', or a plain comma list. Normalise all of them to "a,b".
  An empty result means no filter: every character is eligible.
{% endcomment %}
{% assign selected_ids_csv = trmnl.plugin_settings.custom_fields_values.character_ids
  | join: ','
  | remove: '['
  | remove: ']'
  | remove: '"'
  | remove: ' '
%}
{% assign selected_ids = selected_ids_csv | split: ',' %}
{% assign include_all = false %}
{% if selected_ids_csv == blank %}
  {% assign include_all = true %}
{% endif %}

{% comment %}
  "Randomise characters" setting (randomise_characters, a Yes/No select that
  defaults to Yes). Yes picks a random character first and then one of their
  quotes, so every character is equally likely however many quotes they have.
  No picks any quote at random, so characters with more quotes appear more
  often. TRMNL has no checkbox field and the local preview does not apply
  defaults, so only an explicit "no" turns it off.
{% endcomment %}
{% assign randomise_setting = trmnl.plugin_settings.custom_fields_values.randomise_characters | downcase %}
{% assign randomise_characters = true %}
{% if randomise_setting == 'no' or randomise_setting == 'false' %}
  {% assign randomise_characters = false %}
{% endif %}

{% comment %} Count the characters and quotes that can be chosen. {% endcomment %}
{% assign eligible_character_count = 0 %}
{% assign eligible_quote_count = 0 %}
{% for character in characters %}
  {% if include_all or selected_ids contains character.id %}
    {% if character.quotes.size > 0 %}
      {% assign eligible_character_count = eligible_character_count | plus: 1 %}
      {% assign eligible_quote_count = eligible_quote_count | plus: character.quotes.size %}
    {% endif %}
  {% endif %}
{% endfor %}

{% if eligible_quote_count > 0 %}
  {% assign selected_quote = '' %}
  {% assign selected_character = '' %}
  {% if randomise_characters %}
    {% comment %}
      Time seeds both picks. Plain "seconds mod N" would get stuck on one
      character: the plugin refreshes every 900 seconds, and 900 is divisible
      by many character counts. So microseconds are mixed in and the seed is
      scrambled (multiplicative hashing, keeping the high 16 bits). Then walk
      the eligible characters, skipping until the picked one is reached.
    {% endcomment %}
    {% assign now_seconds = 'now' | date: '%s' | plus: 0 %}
    {% assign now_micros = 'now' | date: '%6N' | plus: 0 %}
    {% assign seed = now_seconds | times: 1000000 | plus: now_micros %}
    {% assign characters_to_skip = seed
      | times: 2654435761
      | modulo: 4294967296
      | divided_by: 65536
      | modulo: eligible_character_count
    %}
    {% assign quote_seed = seed | times: 2246822519 | modulo: 4294967296 | divided_by: 65536 %}
    {% for character in characters %}
      {% if include_all or selected_ids contains character.id %}
        {% if character.quotes.size > 0 %}
          {% if characters_to_skip == 0 %}
            {% assign quote_index = quote_seed | modulo: character.quotes.size %}
            {% assign selected_quote = character.quotes[quote_index] %}
            {% assign selected_character = character %}
            {% break %}
          {% endif %}
          {% assign characters_to_skip = characters_to_skip | minus: 1 %}
        {% endif %}
      {% endif %}
    {% endfor %}
  {% else %}
    {% comment %}
      Pick the Nth eligible quote, where N changes every second. Walk the
      eligible characters, skipping each one's quotes until N lands inside one.
    {% endcomment %}
    {% assign quote_index = 'now' | date: '%s' | modulo: eligible_quote_count %}
    {% for character in characters %}
      {% if include_all or selected_ids contains character.id %}
        {% if quote_index < character.quotes.size %}
          {% assign selected_quote = character.quotes[quote_index] %}
          {% assign selected_character = character %}
          {% break %}
        {% endif %}
        {% assign quote_index = quote_index | minus: character.quotes.size %}
      {% endif %}
    {% endfor %}
  {% endif %}

  {% if selected_quote.size > long_quote_length %}
    {% assign quote_size = sm_long_size %}
    {% assign quote_size_lg = lg_long_size %}
  {% else %}
    {% assign quote_size = sm_size %}
    {% assign quote_size_lg = lg_size %}
  {% endif %}

  <div class="layout h--full layout--{{ view_name }}">
    <div class="flex flex--row portrait:flex--col h--full">
      <section class="w--[80cqw] lg:w--[75cqw] portrait:w--full h--full portrait:h--[65cqh] flex flex--col flex--left">
        <div class="content h--max-[70cqh] portrait:h--max-[52cqh]" data-content-limiter="true">
          <blockquote
            class="{{ quote_size }} {{ quote_size_lg }} pl--1"
            data-clamp="3"
            data-clamp-sm="{{ clamp_sm }}"
            data-clamp-md="{{ clamp_md }}"
            data-clamp-lg="{{ clamp_lg }}"
            data-clamp-portrait="4"
            data-clamp-sm-portrait="{{ clamp_sm_portrait }}"
            data-clamp-md-portrait="{{ clamp_md_portrait }}"
            data-clamp-lg-portrait="{{ clamp_lg_portrait }}"
          >&ldquo;{{ selected_quote | escape }}&rdquo;</blockquote>
        </div>
        <p class="text--base md:text--large lg:text--xlarge pl--1" data-testid="character-name">
          {{ selected_character.name | escape }}
        </p>
      </section>
      <div class="character-art w--[20cqw] lg:w--[25cqw] portrait:w--full h--full portrait:h--[35cqh] flex flex--center">
        <img class="image image--contain image-dither w--full h--full" src="{{ selected_character.imageUrl | escape }}" alt="{{ selected_character.name | escape }}">
      </div>
    </div>
  </div>
  <style>
    blockquote { overflow-wrap: anywhere; }
    .screen--lg:not(.screen--portrait) .layout--quadrant [data-content-limiter="true"] { max-height: 82cqh; }
    .screen--lg:not(.screen--portrait) .layout--quadrant [data-testid="character-name"] { margin-top: auto; }
    .screen--lg:not(.screen--portrait) .layout--quadrant .character-art img { object-position: center bottom; }
  </style>
{% else %}
  <div class="layout h--full">
    <div class="content">
      <p class="text--base">No quotes found for the selected characters.</p>
    </div>
  </div>
{% endif %}
{% endtemplate %}
